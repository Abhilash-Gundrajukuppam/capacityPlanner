                        </div>
                    </div>
                );
            }

            return (
                <div className="app-main">
                    <div style={{ marginBottom: '1.5rem', display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '1rem' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '1rem' }}>
                            <Button variant="secondary" onClick={onBack}>
                                ← Back
                            </Button>
                            <h2 style={{ margin: 0, fontSize: '1.5rem', fontWeight: 600 }}>
                                Manage Locations
                            </h2>
                        </div>
                        <Button onClick={handleAddClick}>
                            + Add Location
                        </Button>
                    </div>

                    {error && <Alert type="error" message={error} />}
                    {successMessage && <Alert type="success" message={successMessage} onClose={() => setSuccessMessage(null)} />}

                    <div className="card">
                        <div className="card-body">
                            {locations.length === 0 ? (
                                <div style={{ textAlign: 'center', padding: '2rem' }}>
                                    <p style={{ color: 'var(--text-secondary)' }}>
                                        No locations found. Click "Add Location" to create one.
                                    </p>
                                </div>
                            ) : (
                                <div className="data-table-container">
                                    <table className="data-table">
                                        <thead>
                                            <tr>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Name')}
                                                >
                                                    Name
                                                    <span className={`sort-indicator ${sortColumn === 'Name' ? 'active' : ''}`}>
                                                        {getSortIndicator('Name')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Country__c')}
                                                >
                                                    Country
                                                    <span className={`sort-indicator ${sortColumn === 'Country__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Country__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Time_Zone__c')}
                                                >
                                                    Time Zone
                                                    <span className={`sort-indicator ${sortColumn === 'Time_Zone__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Time_Zone__c')}
                                                    </span>
                                                </th>
                                                <th>Working Hours</th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Is_Active__c')}
                                                >
                                                    Status
                                                    <span className={`sort-indicator ${sortColumn === 'Is_Active__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Is_Active__c')}
                                                    </span>
                                                </th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
