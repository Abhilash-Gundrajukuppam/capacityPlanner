                sessionDuration: 60 * 60 * 1000, // 60 minutes
                sessionWarningTime: 55 * 60 * 1000, // 55 minutes
                showSessionWarning: false,
                teamMembers: [],
                leaveRequests: [],
                pendingRequests: [],
                message: null
            });

            const updateState = useCallback((updates) => {
                setState(prev => ({ ...prev, ...updates }));
            }, []);

            return [state, updateState];
        };

        // Session Management Hook
        const useSessionManager = (state, updateState) => {
            useEffect(() => {
                // Check existing session on mount
                try {
                    const session = localStorage.getItem('capacityPlannerSession');
                    if (session) {
                        const sessionData = JSON.parse(session);
                        const now = new Date().getTime();
                        
                        if (sessionData.expiryTime > now) {
                            updateState({
                                userContext: sessionData.userContext,
                                sessionStartTime: sessionData.startTime,
                                currentView: 'dashboard'
                            });
                        } else {
                            localStorage.removeItem('capacityPlannerSession');
                        }
                    }
                } catch (e) {
                    console.error('Error checking session:', e);
                }
            }, []);

            useEffect(() => {
                let interval, warningTimeout, expiryTimeout;

                if (state.sessionStartTime) {
                    // Update timer every minute
                    interval = setInterval(() => {
                        const now = new Date().getTime();
                        const elapsed = now - state.sessionStartTime;
                        const remaining = state.sessionDuration - elapsed;

                        if (remaining <= 0) {
                            handleSessionExpiry();
                        }
                    }, 60000);

                    // Show warning 5 minutes before expiry
                    warningTimeout = setTimeout(() => {
                        updateState({ showSessionWarning: true });
                    }, state.sessionWarningTime);

                    // Auto logout
                    expiryTimeout = setTimeout(() => {
                        handleSessionExpiry();
                    }, state.sessionDuration);
                }

                return () => {
                    clearInterval(interval);
                    clearTimeout(warningTimeout);
                    clearTimeout(expiryTimeout);
                };
            }, [state.sessionStartTime]);

            const handleSessionExpiry = () => {
                localStorage.removeItem('capacityPlannerSession');
                updateState({
                    userContext: null,
                    sessionStartTime: null,
                    currentView: 'login',
                    showSessionWarning: false,
                    message: { type: 'warning', text: 'Your session has expired. Please login again.' }
                });
            };

            const extendSession = () => {
                const now = new Date().getTime();
                try {
                    const sessionData = JSON.parse(localStorage.getItem('capacityPlannerSession'));
                    sessionData.startTime = now;
                    sessionData.expiryTime = now + state.sessionDuration;
                    localStorage.setItem('capacityPlannerSession', JSON.stringify(sessionData));
                    
                    updateState({
                        sessionStartTime: now,
                        showSessionWarning: false,
                        message: { type: 'success', text: 'Session extended for another 60 minutes.' }
                    });
                } catch (e) {
                    console.error('Error extending session:', e);
                }
            };

            const logout = () => {
                localStorage.removeItem('capacityPlannerSession');
                updateState({
                    userContext: null,
                    sessionStartTime: null,
                    currentView: 'login',
                    showSessionWarning: false,
                    message: { type: 'info', text: 'You have been logged out successfully.' }
                });
            };

            return { extendSession, logout };
        };

