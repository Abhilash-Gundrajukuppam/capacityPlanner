        // Add/Edit Team Member Modal Component
        const TeamMemberModal = ({ show, member, locations, managers, userContext, onClose, onSave, isProcessing }) => {
            const [formData, setFormData] = useState({
                firstName: '',
                lastName: '',
                email: '',
                role: 'Team Member',
                status: 'Active',
                locationId: '',
                managerId: '',
                startDate: '',
                dailyCapacityHours: '7.5'
            });
            const [errors, setErrors] = useState({});

            useEffect(() => {
                if (member) {
                    // Edit mode - populate form with existing data
                    setFormData({
                        firstName: member.First_Name__c || '',
                        lastName: member.Last_Name__c || '',
                        email: member.Email__c || '',
                        role: member.Role__c || 'Team Member',
                        status: member.Status__c || 'Active',
                        locationId: member.Location__c || '',
                        managerId: member.Manager__c || '',
                        startDate: member.Start_Date__c || '',
                        dailyCapacityHours: member.Daily_Capacity_Hours__c?.toString() || '7.5'
                    });
                } else {
                    // Add mode - set defaults
                    setFormData({
                        firstName: '',
                        lastName: '',
                        email: '',
                        role: 'Team Member',
                        status: 'Active',
                        locationId: '',
                        managerId: userContext?.Id || '',
                        startDate: new Date().toISOString().split('T')[0],
                        dailyCapacityHours: '7.5'
                    });
                }
                setErrors({});
            }, [member, show, userContext]);

            if (!show) return null;

            const handleChange = (field, value) => {
                setFormData(prev => ({ ...prev, [field]: value }));
                // Clear error when field is changed
                if (errors[field]) {
                    setErrors(prev => ({ ...prev, [field]: null }));
                }
            };

            const validateForm = () => {
                const newErrors = {};
                if (!formData.firstName.trim()) newErrors.firstName = 'First name is required';
                if (!formData.lastName.trim()) newErrors.lastName = 'Last name is required';
                if (!formData.email.trim()) {
                    newErrors.email = 'Email is required';
                } else if (!isValidEmail(formData.email)) {
                    newErrors.email = 'Please enter a valid email address';
                }
                if (!formData.role) newErrors.role = 'Role is required';
                if (!formData.status) newErrors.status = 'Status is required';
                if (!formData.locationId) newErrors.locationId = 'Location is required';
                if (!formData.dailyCapacityHours || parseFloat(formData.dailyCapacityHours) <= 0) {
                    newErrors.dailyCapacityHours = 'Please enter valid daily capacity hours';
                }
                setErrors(newErrors);
                return Object.keys(newErrors).length === 0;
            };

            const handleSave = () => {
                if (!validateForm()) return;
                onSave(formData, member?.Id);
            };

            const isEditMode = !!member;

            return (
                <div className="modal-backdrop">
                    <div className="modal" style={{ maxWidth: '600px' }}>
                        <div className="card-header">
                            <h2 style={{ margin: 0 }}>{isEditMode ? 'Edit Team Member' : 'Add New Team Member'}</h2>
                        </div>
                        <div className="card-body" style={{ position: 'relative' }}>
                            {isProcessing && <div className="loading-overlay"><LoadingSpinner /></div>}
                            
                            <div className="grid grid-2">
                                <div className="form-group">
                                    <label className="form-label">First Name *</label>
                                    <input
                                        type="text"
                                        className="form-input"
                                        value={formData.firstName}
                                        onChange={(e) => handleChange('firstName', e.target.value)}
                                        placeholder="Enter first name"
                                    />
                                    {errors.firstName && <Alert type="error" message={errors.firstName} />}
                                </div>

                                <div className="form-group">
                                    <label className="form-label">Last Name *</label>
                                    <input
                                        type="text"
                                        className="form-input"
                                        value={formData.lastName}
                                        onChange={(e) => handleChange('lastName', e.target.value)}
                                        placeholder="Enter last name"
                                    />
                                    {errors.lastName && <Alert type="error" message={errors.lastName} />}
                                </div>
                            </div>

                            <div className="form-group">
                                <label className="form-label">Email *</label>
                                <input
                                    type="email"
                                    className="form-input"
                                    value={formData.email}
                                    onChange={(e) => handleChange('email', e.target.value)}
                                    placeholder="email@company.com"
                                    disabled={isEditMode}
                                />
                                {isEditMode && (
                                    <small style={{ color: 'var(--text-secondary)' }}>Email cannot be changed after creation</small>
                                )}
                                {errors.email && <Alert type="error" message={errors.email} />}
                            </div>

                            <div className="grid grid-2">
                                <div className="form-group">
                                    <label className="form-label">Role *</label>
                                    <select
                                        className="form-input"
                                        value={formData.role}
                                        onChange={(e) => handleChange('role', e.target.value)}
                                    >
                                        <option value="Team Member">Team Member</option>
                                        <option value="Manager">Manager</option>
                                    </select>
                                    {errors.role && <Alert type="error" message={errors.role} />}
                                </div>

                                <div className="form-group">
                                    <label className="form-label">Status *</label>
                                    <select
                                        className="form-input"
                                        value={formData.status}
                                        onChange={(e) => handleChange('status', e.target.value)}
                                    >
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                    {errors.status && <Alert type="error" message={errors.status} />}
                                </div>
                            </div>

                            <div className="grid grid-2">
                                <div className="form-group">
                                    <label className="form-label">Location *</label>
                                    <select
                                        className="form-input"
                                        value={formData.locationId}
                                        onChange={(e) => handleChange('locationId', e.target.value)}
                                    >
                                        <option value="">Select Location</option>
                                        {locations.map(loc => (
                                            <option key={loc.Id} value={loc.Id}>
                                                {loc.Name}{loc.Country__c ? ` (${loc.Country__c})` : ''}
                                            </option>
                                        ))}
                                    </select>
                                    {errors.locationId && <Alert type="error" message={errors.locationId} />}
                                </div>

                                <div className="form-group">
                                    <label className="form-label">Manager</label>
                                    <select
                                        className="form-input"
                                        value={formData.managerId}
                                        onChange={(e) => handleChange('managerId', e.target.value)}
                                    >
                                        <option value="">No Manager</option>
                                        {managers.filter(m => m.Id !== member?.Id).map(mgr => (
                                            <option key={mgr.Id} value={mgr.Id}>
                                                {mgr.First_Name__c} {mgr.Last_Name__c}
                                            </option>
                                        ))}
                                    </select>
                                </div>
                            </div>

                            <div className="grid grid-2">
                                <div className="form-group">
                                    <label className="form-label">Start Date</label>
                                    <input
                                        type="date"
                                        className="form-input"
                                        value={formData.startDate}
                                        onChange={(e) => handleChange('startDate', e.target.value)}
                                    />
                                </div>

                                <div className="form-group">
                                    <label className="form-label">Daily Capacity Hours *</label>
                                    <input
                                        type="number"
                                        className="form-input"
                                        value={formData.dailyCapacityHours}
                                        onChange={(e) => handleChange('dailyCapacityHours', e.target.value)}
                                        min="0"
                                        max="24"
                                        step="0.5"
                                        placeholder="7.5"
                                    />
                                    {errors.dailyCapacityHours && <Alert type="error" message={errors.dailyCapacityHours} />}
                                </div>
                            </div>

                            <div className="grid grid-2" style={{ gap: '1rem', marginTop: '1rem' }}>
                                <Button variant="secondary" onClick={onClose} disabled={isProcessing}>
                                    Cancel
                                </Button>
                                <Button onClick={handleSave} loading={isProcessing}>
                                    {isEditMode ? 'Save Changes' : 'Add Team Member'}
                                </Button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        };

        // Add/Edit Location Modal Component
        const LocationModal = ({ show, location, userContext, onClose, onSave, isProcessing }) => {
            const [formData, setFormData] = useState({
                name: '',
                country: '',
                timeZone: '',
                workingHoursStart: '09:00',
                workingHoursEnd: '17:00',
                isActive: true
            });
            const [errors, setErrors] = useState({});

            useEffect(() => {
                if (location) {
                    // Edit mode - populate form with existing data
                    const formatTime = (timeValue) => {
                        if (!timeValue) return '';
                        // Handle time format from Salesforce (milliseconds since midnight)
                        if (typeof timeValue === 'number') {
                            const hours = Math.floor(timeValue / 3600000);
                            const minutes = Math.floor((timeValue % 3600000) / 60000);
                            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;
                        }
                        return timeValue;
                    };
                    
                    setFormData({
                        name: location.Name || '',
                        country: location.Country__c || '',
                        timeZone: location.Time_Zone__c || '',
                        workingHoursStart: formatTime(location.Working_Hours_Start__c) || '09:00',
                        workingHoursEnd: formatTime(location.Working_Hours_End__c) || '17:00',
                        isActive: location.Is_Active__c !== false
                    });
                } else {
                    // Add mode - set defaults
                    setFormData({
                        name: '',
                        country: '',
                        timeZone: '',
                        workingHoursStart: '09:00',
                        workingHoursEnd: '17:00',
                        isActive: true
                    });
                }
                setErrors({});
            }, [location, show]);

            if (!show) return null;

            const handleChange = (field, value) => {
                setFormData(prev => ({ ...prev, [field]: value }));
                if (errors[field]) {
                    setErrors(prev => ({ ...prev, [field]: null }));
                }
            };

            const validateForm = () => {
                const newErrors = {};
                if (!formData.name.trim()) newErrors.name = 'Location name is required';
                setErrors(newErrors);
                return Object.keys(newErrors).length === 0;
