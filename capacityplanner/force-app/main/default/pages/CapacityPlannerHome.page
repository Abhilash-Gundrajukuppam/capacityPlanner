                                        <thead>
                                            <tr>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('TeamMemberName')}
                                                >
                                                    Team Member
                                                    <span className={`sort-indicator ${sortColumn === 'TeamMemberName' ? 'active' : ''}`}>
                                                        {getSortIndicator('TeamMemberName')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Start_Date__c')}
                                                >
                                                    Start Date
                                                    <span className={`sort-indicator ${sortColumn === 'Start_Date__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Start_Date__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('End_Date__c')}
                                                >
                                                    End Date
                                                    <span className={`sort-indicator ${sortColumn === 'End_Date__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('End_Date__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Leave_Type__c')}
                                                >
                                                    Type
                                                    <span className={`sort-indicator ${sortColumn === 'Leave_Type__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Leave_Type__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Leave_Category__c')}
                                                >
                                                    Category
                                                    <span className={`sort-indicator ${sortColumn === 'Leave_Category__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Leave_Category__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Status__c')}
                                                >
                                                    Status
                                                    <span className={`sort-indicator ${sortColumn === 'Status__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Status__c')}
                                                    </span>
                                                </th>
                                                <th>Reason</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {sortedRequests.map((request, index) => (
                                                <tr key={request.Id || index}>
                                                    <td style={{ fontWeight: 500 }}>
                                                        {request.Requestor__r?.First_Name__c} {request.Requestor__r?.Last_Name__c}
                                                    </td>
                                                    <td>{formatDate(request.Start_Date__c)}</td>
                                                    <td>{formatDate(request.End_Date__c)}</td>
                                                    <td>{request.Leave_Type__c}</td>
                                                    <td>{request.Leave_Category__c}</td>
                                                    <td>
                                                        <span className={`badge ${getStatusBadgeClass(request.Status__c)}`}>
                                                            {request.Status__c}
                                                        </span>
                                                    </td>
                                                    <td style={{ maxWidth: '200px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                        {request.Reason__c || '-'}
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            );
        };

        // Sprint Capacity Planner Component
        const SprintCapacityPlanner = ({ userContext, onBack }) => {
            const [sprints, setSprints] = useState([]);
            const [selectedSprintId, setSelectedSprintId] = useState('');
            const [gridData, setGridData] = useState(null);
            const [isLoading, setIsLoading] = useState(true);
            const [isRefreshing, setIsRefreshing] = useState(false);
            const [error, setError] = useState(null);
            const [successMessage, setSuccessMessage] = useState(null);
            
            // Modal states
            const [showSprintModal, setShowSprintModal] = useState(false);
            const [editingSprint, setEditingSprint] = useState(null);
            const [sprintFormData, setSprintFormData] = useState({ name: '', startDate: '', endDate: '' });
            const [sprintFormErrors, setSprintFormErrors] = useState({});
            const [isSavingSprint, setIsSavingSprint] = useState(false);
            
            // Cell editing state
            const [editingCell, setEditingCell] = useState(null);
            const [editingValue, setEditingValue] = useState('');
            const [showOverrideModal, setShowOverrideModal] = useState(false);
            const [overrideReason, setOverrideReason] = useState('');
            const [pendingCellUpdate, setPendingCellUpdate] = useState(null);

            // Load sprints on mount
            useEffect(() => {
                loadSprints();
            }, [userContext]);

            // Load grid data when sprint selected
            useEffect(() => {
                if (selectedSprintId) {
                    loadGridData(selectedSprintId);
                }
            }, [selectedSprintId]);

            const loadSprints = async () => {
                try {
                    const result = await apiService.getSprints(userContext.Email__c);
                    if (result.success) {
                        setSprints(result.sprints || []);
                        // Auto-select first sprint if available
                        if (result.sprints && result.sprints.length > 0 && !selectedSprintId) {
                            setSelectedSprintId(result.sprints[0].Id);
                        }
                    } else {
                        setError(result.message || 'Failed to load sprints');
                    }
                } catch (err) {
                    setError('Error loading sprints. Please try again.');
                } finally {
                    setIsLoading(false);
                }
            };

            const loadGridData = async (sprintId) => {
                setIsRefreshing(true);
                setError(null);
                try {
                    const result = await apiService.getSprintGridData(userContext.Email__c, sprintId);
                    if (result.success) {
                        setGridData(result.gridData);
                    } else {
                        setError(result.message || 'Failed to load capacity data');
                    }
                } catch (err) {
                    setError('Error loading capacity data. Please try again.');
                } finally {
                    setIsRefreshing(false);
                }
            };

            const handleRefresh = async (forceRecalculate = false) => {
                if (!selectedSprintId) return;
                setIsRefreshing(true);
                setError(null);
                try {
                    const result = await apiService.refreshSprintCapacity(userContext.Email__c, selectedSprintId, forceRecalculate);
                    if (result.success) {
                        setSuccessMessage(forceRecalculate ? 'Capacity recalculated successfully!' : 'Capacity refreshed successfully!');
                        await loadGridData(selectedSprintId);
                    } else {
                        setError(result.message || 'Failed to refresh capacity');
                    }
                } catch (err) {
                    setError('Error refreshing capacity. Please try again.');
                } finally {
                    setIsRefreshing(false);
                }
            };

            // Sprint CRUD handlers
            const handleOpenSprintModal = (sprint = null) => {
                if (sprint) {
                    setEditingSprint(sprint);
                    setSprintFormData({
                        name: sprint.Name || '',
                        startDate: sprint.Start_Date__c || '',
                        endDate: sprint.End_Date__c || ''
                    });
                } else {
                    setEditingSprint(null);
                    setSprintFormData({ name: '', startDate: '', endDate: '' });
                }
                setSprintFormErrors({});
                setShowSprintModal(true);
            };

            const handleCloseSprintModal = () => {
                setShowSprintModal(false);
                setEditingSprint(null);
                setSprintFormData({ name: '', startDate: '', endDate: '' });
                setSprintFormErrors({});
            };

            const validateSprintForm = () => {
                const errors = {};
                if (!sprintFormData.name.trim()) errors.name = 'Sprint name is required';
                if (!sprintFormData.startDate) errors.startDate = 'Start date is required';
                if (!sprintFormData.endDate) errors.endDate = 'End date is required';
                if (sprintFormData.startDate && sprintFormData.endDate) {
                    if (new Date(sprintFormData.startDate) > new Date(sprintFormData.endDate)) {
                        errors.endDate = 'End date must be after start date';
                    }
                }
                setSprintFormErrors(errors);
                return Object.keys(errors).length === 0;
            };

            const handleSaveSprint = async () => {
                if (!validateSprintForm()) return;
                setIsSavingSprint(true);
                setError(null);
                
                try {
                    let result;
                    if (editingSprint) {
                        result = await apiService.updateSprint(
                            userContext.Email__c,
                            editingSprint.Id,
                            sprintFormData.name,
                            sprintFormData.startDate,
                            sprintFormData.endDate
                        );
                    } else {
                        result = await apiService.createSprint(
                            userContext.Email__c,
                            sprintFormData.name,
                            sprintFormData.startDate,
                            sprintFormData.endDate
                        );
                    }
                    
                    if (result.success) {
                        setSuccessMessage(editingSprint ? 'Sprint updated successfully!' : 'Sprint created successfully!');
                        handleCloseSprintModal();
                        await loadSprints();
                        if (result.sprintId) {
                            setSelectedSprintId(result.sprintId);
                        }
                    } else {
                        setSprintFormErrors({ general: result.message || 'Failed to save sprint' });
                    }
                } catch (err) {
                    setSprintFormErrors({ general: 'Error saving sprint. Please try again.' });
                } finally {
                    setIsSavingSprint(false);
                }
            };

            const handleDeleteSprint = async (sprintId) => {
                if (!confirm('Are you sure you want to delete this sprint? This action cannot be undone.')) return;
                
                setIsLoading(true);
                try {
                    const result = await apiService.deleteSprint(userContext.Email__c, sprintId);
                    if (result.success) {
                        setSuccessMessage('Sprint deleted successfully!');
                        if (selectedSprintId === sprintId) {
                            setSelectedSprintId('');
                            setGridData(null);
                        }
                        await loadSprints();
                    } else {
                        setError(result.message || 'Failed to delete sprint');
                    }
                } catch (err) {
                    setError('Error deleting sprint. Please try again.');
                } finally {
                    setIsLoading(false);
                }
            };

            // Cell editing handlers
            const handleCellClick = (memberId, dayIndex, capacity) => {
                if (!capacity.editable) return;
                setEditingCell({ memberId, dayIndex });
                setEditingValue(capacity.hours?.toString() || '');
            };

            const handleCellBlur = () => {
                if (editingCell && editingValue !== '') {
                    const member = gridData?.teamMembers?.find(m => m.id === editingCell.memberId);
                    const capacity = member?.dailyCapacity?.[editingCell.dayIndex];
                    
                    if (capacity && parseFloat(editingValue) !== capacity.hours) {
                        setPendingCellUpdate({
                            capacityRecordId: capacity.recordId,
                            newHours: parseFloat(editingValue),
                            memberId: editingCell.memberId,
                            dayIndex: editingCell.dayIndex
                        });
                        setOverrideReason('');
                        setShowOverrideModal(true);
                    }
                }
                setEditingCell(null);
            };

            const handleCellKeyDown = (e) => {
                if (e.key === 'Enter') {
                    handleCellBlur();
                } else if (e.key === 'Escape') {
                    setEditingCell(null);
                    setEditingValue('');
                }
            };

            const handleConfirmOverride = async () => {
                if (!pendingCellUpdate) return;
                
                setShowOverrideModal(false);
                setIsRefreshing(true);
                
                try {
                    const result = await apiService.updateCapacityCell(
                        userContext.Email__c,
                        pendingCellUpdate.capacityRecordId,
                        pendingCellUpdate.newHours,
                        overrideReason
                    );
                    
                    if (result.success) {
                        setSuccessMessage('Capacity updated successfully!');
                        await loadGridData(selectedSprintId);
                    } else {
                        setError(result.message || 'Failed to update capacity');
                    }
                } catch (err) {
                    setError('Error updating capacity. Please try again.');
                } finally {
                    setIsRefreshing(false);
                    setPendingCellUpdate(null);
                    setOverrideReason('');
                }
            };

            const formatDate = (dateStr) => {
                if (!dateStr) return '-';
                const date = new Date(dateStr);
                return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            };

            const getCellClass = (capacity) => {
                let classes = 'capacity-cell';
                if (capacity.status === 'weekend') classes += ' weekend';
                else if (capacity.status === 'leave') classes += ' leave';
                else if (capacity.status === 'holiday') classes += ' holiday';
                else if (capacity.status === 'partial') classes += ' partial';
                else if (capacity.status === 'override') classes += ' override';
                if (capacity.editable) classes += ' editable';
                return classes;
            };

            if (isLoading) {
                return (
                    <div className="app-main">
                        <div style={{ textAlign: 'center', padding: '2rem' }}>
                            <LoadingSpinner />
                            <p style={{ marginTop: '1rem' }}>Loading Sprint Capacity Planner...</p>
                        </div>
                    </div>
                );
            }

            return (
                <div className="app-main">
                    {/* Header */}
                    <div style={{ marginBottom: '1.5rem', display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '1rem' }}>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '1rem' }}>
                            <Button variant="secondary" onClick={onBack}>
                                ← Back
                            </Button>
                            <h2 style={{ margin: 0, fontSize: '1.5rem', fontWeight: 600 }}>
                                📊 Sprint Capacity Planner
                            </h2>
                        </div>
                        <div style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                            <select
                                className="form-input"
                                value={selectedSprintId}
                                onChange={(e) => setSelectedSprintId(e.target.value)}
                                style={{ minWidth: '200px' }}
                            >
                                <option value="">Select Sprint...</option>
                                {sprints.map(sprint => (
                                    <option key={sprint.Id} value={sprint.Id}>
                                        {sprint.Name} ({formatDate(sprint.Start_Date__c)} - {formatDate(sprint.End_Date__c)})
                                    </option>
                                ))}
                            </select>
                            <Button variant="secondary" onClick={() => handleOpenSprintModal()}>
                                + New Sprint
                            </Button>
                            {selectedSprintId && (
                                <>
                                    <Button variant="secondary" onClick={() => {
                                        const sprint = sprints.find(s => s.Id === selectedSprintId);
                                        handleOpenSprintModal(sprint);
                                    }}>
                                        ✏️ Edit
                                    </Button>
                                    <Button 
                                        onClick={() => handleRefresh(false)} 
                                        disabled={isRefreshing}
                                        loading={isRefreshing}
                                    >
                                        🔄 Refresh
                                    </Button>
                                </>
                            )}
                        </div>
                    </div>

                    {error && <Alert type="error" message={error} />}
                    {successMessage && <Alert type="success" message={successMessage} onClose={() => setSuccessMessage(null)} />}

                    {/* Legend */}
                    <div style={{ marginBottom: '1rem', padding: '0.75rem', background: '#f8f9fa', borderRadius: 'var(--radius-sm)', display: 'flex', flexWrap: 'wrap', gap: '1rem' }}>
                        <div className="legend-item">
                            <div className="legend-color" style={{ background: '#dcfce7' }}></div>
                            <span>Holiday</span>
                        </div>
                        <div className="legend-item">
                            <div className="legend-color" style={{ background: '#fee2e2' }}></div>
                            <span>Full Leave</span>
                        </div>
                        <div className="legend-item">
                            <div className="legend-color" style={{ background: '#fef3c7' }}></div>
                            <span>Partial Leave</span>
                        </div>
                        <div className="legend-item">
                            <div className="legend-color" style={{ background: '#f5f5f5' }}></div>
                            <span>Weekend</span>
                        </div>
                        <div className="legend-item">
                            <div className="legend-color" style={{ background: '#dbeafe' }}></div>
                            <span>Manual Override</span>
                        </div>
                    </div>

                    {/* Capacity Grid */}
                    { !selectedSprintId ? (
                        <div className="card">
                            <div className="card-body" style={{ textAlign: 'center', padding: '3rem' }}>
                                <p style={{ color: 'var(--text-secondary)', fontSize: '1.1rem' }}>
                                    {sprints.length === 0 
                                        ? 'No sprints found. Create a new sprint to get started!'
                                        : 'Select a sprint to view team capacity.'
                                    }
                                </p>
                                {sprints.length === 0 && (
                                    <Button onClick={() => handleOpenSprintModal()} style={{ marginTop: '1rem' }}>
                                        + Create First Sprint
                                    </Button>
                                )}
                            </div>
                        </div>
                    ) : isRefreshing ? (
                        <div className="card">
                            <div className="card-body" style={{ textAlign: 'center', padding: '3rem' }}>
                                <LoadingSpinner />
                                <p style={{ marginTop: '1rem' }}>Loading capacity data...</p>
                            </div>
                        </div>
                    ) : gridData ? (
                        <div className="card">
                            <div className="card-header" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                                <div>
                                    <h3 style={{ margin: 0 }}>{gridData.sprintName}</h3>
                                    <small style={{ color: 'var(--text-secondary)' }}>
                                        {formatDate(gridData.startDate)} - {formatDate(gridData.endDate)} | 
                                        Total Team Capacity: <strong>{gridData.totalCapacity?.toFixed(1) || 0}h</strong>
                                    </small>
                                </div>
                                <Button 
                                    variant="secondary" 
                                    onClick={() => handleRefresh(true)}
                                    disabled={isRefreshing}
                                    title="Recalculate all capacity (resets manual overrides)"
                                >
                                    🔃 Recalculate All
                                </Button>
                            </div>
                            <div className="card-body" style={{ padding: 0 }}>
                                <div className="sprint-grid-container" style={{ maxHeight: '60vh', overflowY: 'auto' }}>
                                    <table className="sprint-grid">
                                        <thead>
                                            <tr>
                                                <th className="sticky-col">Team Member</th>
                                                {gridData.dates?.map((date, idx) => (
                                                    <th key={idx} className={date.isWeekend ? 'weekend' : ''}>
                                                        <div className="day-header">{date.dayName}</div>
                                                        <div>{formatDate(date.date)}</div>
                                                    </th>
                                                ))}
                                                <th className="sticky-total">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {gridData.teamMembers?.map((member) => (
                                                <tr key={member.id}>
                                                    <td className="sticky-col">
                                                        <div style={{ fontWeight: 500 }}>{member.name}</div>
                                                        <small style={{ color: 'var(--text-secondary)' }}>{member.role}</small>
                                                    </td>
                                                    {member.dailyCapacity?.map((capacity, dayIdx) => (
                                                        <td 
                                                            key={dayIdx}
                                                            className={getCellClass(capacity)}
                                                            onClick={() => handleCellClick(member.id, dayIdx, capacity)}
                                                            title={capacity.tooltip || ''}
                                                        >
                                                            {editingCell?.memberId === member.id && editingCell?.dayIndex === dayIdx ? (
                                                                <input
                                                                    type="number"
                                                                    value={editingValue}
                                                                    onChange={(e) => setEditingValue(e.target.value)}
                                                                    onBlur={handleCellBlur}
                                                                    onKeyDown={handleCellKeyDown}
                                                                    autoFocus
                                                                    min="0"
                                                                    max="24"
                                                                    step="0.5"
                                                                />
                                                            ) : (
                                                                capacity.hours?.toFixed(1) || '0'
                                                            )}
                                                        </td>
                                                    ))}
                                                    <td className="sticky-total">
                                                        {member.totalHours?.toFixed(1) || '0'}
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                        <tfoot>
                                            <tr style={{ background: '#f0f4ff', fontWeight: 600 }}>
                                                <td className="sticky-col">Daily Total</td>
                                                {gridData.dates?.map((date, idx) => {
                                                    const dayTotal = gridData.teamMembers?.reduce((sum, m) => 
                                                        sum + (m.dailyCapacity?.[idx]?.hours || 0), 0) || 0;
                                                    return (
                                                        <td key={idx} className={date.isWeekend ? 'weekend' : ''}>
                                                            {dayTotal.toFixed(1)}
                                                        </td>
                                                    );
                                                })}
                                                <td className="sticky-total" style={{ background: '#c7d2fe' }}>
                                                    {gridData.totalCapacity?.toFixed(1) || '0'}
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    ) : (
                        <div className="card">
                            <div className="card-body" style={{ textAlign: 'center', padding: '2rem' }}>
                                <p style={{ color: 'var(--text-secondary)' }}>
                                    No capacity data available for this sprint.
                                </p>
                            </div>
                        </div>
                    )}

                    {/* Sprint Modal */}
                    {showSprintModal && (
                        <div className="modal-backdrop">
                            <div className="modal" style={{ maxWidth: '450px' }}>
                                <div className="card-header">
                                    <h2 style={{ margin: 0 }}>{editingSprint ? 'Edit Sprint' : 'Create New Sprint'}</h2>
                                </div>
                                <div className="card-body" style={{ position: 'relative' }}>
                                    {isSavingSprint && <div className="loading-overlay"><LoadingSpinner /></div>}
                                    
                                    {sprintFormErrors.general && (
                                        <Alert type="error" message={sprintFormErrors.general} />
                                    )}

                                    <div className="form-group">
                                        <label className="form-label">Sprint Name *</label>
                                        <input
                                            type="text"
                                            className="form-input"
                                            value={sprintFormData.name}
                                            onChange={(e) => setSprintFormData(prev => ({ ...prev, name: e.target.value }))}
                                            placeholder="e.g., Sprint 23"
                                        />
                                        {sprintFormErrors.name && <Alert type="error" message={sprintFormErrors.name} />}
                                    </div>

                                    <div className="grid grid-2">
                                        <div className="form-group">
                                            <label className="form-label">Start Date *</label>
                                            <input
                                                type="date"
                                                className="form-input"
                                                value={sprintFormData.startDate}
                                                onChange={(e) => setSprintFormData(prev => ({ ...prev, startDate: e.target.value }))}
                                            />
                                            {sprintFormErrors.startDate && <Alert type="error" message={sprintFormErrors.startDate} />}
                                        </div>
                                        <div className="form-group">
                                            <label className="form-label">End Date *</label>
                                            <input
                                                type="date"
                                                className="form-input"
                                                value={sprintFormData.endDate}
                                                onChange={(e) => setSprintFormData(prev => ({ ...prev, endDate: e.target.value }))}
                                            />
                                            {sprintFormErrors.endDate && <Alert type="error" message={sprintFormErrors.endDate} />}
                                        </div>
                                    </div>

                                    <div className="info-box">
                                        <span className="info-box-icon">ℹ️</span>
                                        <span>Sprints cannot overlap with existing sprints. The system will validate dates automatically.</span>
                                    </div>

                                    <div style={{ display: 'flex', gap: '1rem', marginTop: '1rem' }}>
                                        {editingSprint && (
                                            <button 
                                                className="button action-btn-cancel"
                                                style={{ flex: 1, minHeight: '2.5rem' }}
                                                onClick={() => {
                                                    handleCloseSprintModal();
                                                    handleDeleteSprint(editingSprint.Id);
                                                }}
                                                disabled={isSavingSprint}
                                            >
                                                🗑️ Delete
                                            </button>
                                        )}
                                        <Button 
                                            variant="secondary" 
                                            onClick={handleCloseSprintModal}
                                            disabled={isSavingSprint}
                                            style={{ flex: 1 }}
                                        >
                                            Cancel
                                        </Button>
                                        <Button 
                                            onClick={handleSaveSprint}
                                            loading={isSavingSprint}
                                            style={{ flex: 1 }}
                                        >
                                            {editingSprint ? 'Save Changes' : 'Create Sprint'}
                                        </Button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}

                    {/* Override Reason Modal */}
                    {showOverrideModal && (
                        <div className="modal-backdrop">
                            <div className="modal" style={{ maxWidth: '400px' }}>
                                <div className="card-header">
                                    <h2 style={{ margin: 0 }}>Override Capacity</h2>
                                </div>
                                <div className="card-body">
                                    <p style={{ marginBottom: '1rem' }}>
                                        You are manually overriding the calculated capacity. Please provide a reason for this change (optional but recommended for audit trail).
                                    </p>
                                    
                                    <div className="form-group">
                                        <label className="form-label">Override Reason</label>
                                        <textarea
                                            className="form-input"
                                            rows="3"
                                            value={overrideReason}
                                            onChange={(e) => setOverrideReason(e.target.value)}
                                            placeholder="e.g., Team member working half day due to training..."
                                        />
                                    </div>

                                    <div className="grid grid-2" style={{ gap: '1rem' }}>
                                        <Button 
                                            variant="secondary" 
                                            onClick={() => {
                                                setShowOverrideModal(false);
                                                setPendingCellUpdate(null);
                                                setOverrideReason('');
                                            }}
                                        >
                                            Cancel
                                        </Button>
                                        <Button onClick={handleConfirmOverride}>
                                            Confirm Override
                                        </Button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        const LeaveRequestForm = ({ userContext, onSubmit, onCancel, isLoading }) => {
            // Use refs for uncontrolled inputs to avoid VF merge field parsing
            const formRef = React.useRef(null);
            const [errors, setErrors] = useState({});
            const [singleDayChecked, setSingleDayChecked] = useState(false);

            const handleSingleDayChange = (e) => {
                const checked = e.target.checked;
                setSingleDayChecked(checked);
                if (checked && formRef.current) {
                    const startVal = formRef.current.elements['startDate'].value;
                    formRef.current.elements['endDate'].value = startVal;
                }
            };

            const handleStartDateChange = (e) => {
                if (singleDayChecked && formRef.current) {
                    formRef.current.elements['endDate'].value = e.target.value;
                }
            };

            const handleSubmit = (e) => {
                e.preventDefault();
                const form = formRef.current;
                if (!form) return;

                const leaveType = form.elements['leaveType'].value;
                const leaveCategory = form.elements['leaveCategory'].value;
                const startDate = form.elements['startDate'].value;
                const endDate = form.elements['endDate'].value;
                const hoursRequested = form.elements['hoursRequested'].value;
                const reason = form.elements['reason'].value;

                // Validate
                const newErrors = {};
                if (!leaveType) newErrors.leaveType = 'Please select a leave type';
                if (!leaveCategory) newErrors.leaveCategory = 'Please select a leave category';
                if (!startDate) newErrors.startDate = 'Please select a start date';
                if (!singleDayChecked && !endDate) newErrors.endDate = 'Please select an end date';
                if (!hoursRequested || parseFloat(hoursRequested) <= 0) {
                    newErrors.hoursRequested = 'Please enter valid hours requested';
                }
                if (!reason.trim()) newErrors.reason = 'Please provide a reason for your leave';
                
                if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
                    newErrors.endDate = 'End date must be after start date';
                }
                
                setErrors(newErrors);
                
                if (Object.keys(newErrors).length === 0) {
                    onSubmit({
                        leaveType,
                        leaveCategory,
                        startDate,
                        endDate: singleDayChecked ? startDate : endDate,
                        hoursRequested,
                        reason,
                        isSingleDay: singleDayChecked
                    });
                }
            };

            const errLeaveType = errors.leaveType;
            const errLeaveCategory = errors.leaveCategory;
            const errStartDate = errors.startDate;
            const errEndDate = errors.endDate;
            const errHoursRequested = errors.hoursRequested;
            const errReason = errors.reason;

            return (
                <div className="app-main">
                    <div className="card" style={{ maxWidth: '600px', margin: '0 auto' }}>
                        <div className="card-header">
                            <h2 style={{ margin: 0 }}>Submit Leave Request</h2>
                        </div>
                        <div className="card-body" style={{ position: 'relative' }}>
                            {isLoading && <div className="loading-overlay"><LoadingSpinner /></div>}
                            
                            <form ref={formRef} onSubmit={handleSubmit}>
                                <div className="grid grid-2">
                                    <div className="form-group">
                                        <label className="form-label" htmlFor="leaveType">Leave Type *</label>
                                        <select
                                            id="leaveType"
                                            name="leaveType"
                                            className="form-input"
                                            defaultValue=""
                                        >
                                            <option value="">Select Leave Type</option>
                                            <option value="Annual Leave">Annual Leave</option>
                                            <option value="Sick Leave">Sick Leave</option>
                                            <option value="Personal Leave">Personal Leave</option>
                                            <option value="Emergency Leave">Emergency Leave</option>
                                            <option value="Maternity Leave">Maternity Leave</option>
                                            <option value="Paternity Leave">Paternity Leave</option>
                                        </select>
                                        {errLeaveType && <Alert type="error" message={errLeaveType} />}
                                    </div>

                                    <div className="form-group">
                                        <label className="form-label" htmlFor="leaveCategory">Leave Category *</label>
                                        <select
                                            id="leaveCategory"
                                            name="leaveCategory"
                                            className="form-input"
                                            defaultValue=""
                                        >
                                            <option value="">Select Category</option>
                                            <option value="Full Day">Full Day</option>
                                            <option value="Half Day">Half Day</option>
                                            <option value="Custom Hours">Custom Hours</option>
                                        </select>
                                        {errLeaveCategory && <Alert type="error" message={errLeaveCategory} />}
                                    </div>
                                </div>

                                <div className="form-group">
                                    <label className="form-label">
                                        <input
                                            type="checkbox"
                                            name="isSingleDay"
                                            onChange={handleSingleDayChange}
                                            style={{ marginRight: '0.5rem' }}
                                        />
                                        Single Day Leave
                                    </label>
                                </div>

                                <div className="grid grid-2">
                                    <div className="form-group">
                                        <label className="form-label" htmlFor="startDate">Start Date *</label>
                                        <input
                                            type="date"
                                            id="startDate"
                                            name="startDate"
                                            className="form-input"
                                            onChange={handleStartDateChange}
                                        />
                                        {errStartDate && <Alert type="error" message={errStartDate} />}
                                    </div>

                                    <div className="form-group">
                                        <label className="form-label" htmlFor="endDate">
                                            End Date {singleDayChecked === false && '*'}
                                        </label>
                                        <input
                                            type="date"
                                            id="endDate"
                                            name="endDate"
                                            className="form-input"
                                            disabled={singleDayChecked}
                                        />
                                        {errEndDate && <Alert type="error" message={errEndDate} />}
                                    </div>
                                </div>

                                <div className="form-group">
                                    <label className="form-label" htmlFor="hoursRequested">Hours Requested *</label>
                                    <input
                                        type="number"
                                        id="hoursRequested"
                                        name="hoursRequested"
                                        className="form-input"
                                        placeholder="8"
                                        min="0.5"
                                        max="24"
                                        step="0.5"
                                    />
                                    {errHoursRequested && <Alert type="error" message={errHoursRequested} />}
                                </div>

                                <div className="form-group">
                                    <label className="form-label" htmlFor="reason">Reason *</label>
                                    <textarea
                                        id="reason"
                                        name="reason"
                                        className="form-input"
                                        rows="4"
                                        placeholder="Please provide a reason for your leave request..."
                                    />
                                    {errReason && <Alert type="error" message={errReason} />}
                                </div>

                                <div className="grid grid-2">
                                    <Button 
                                        type="button" 
                                        variant="secondary" 
                                        onClick={onCancel}
                                        disabled={isLoading}
                                    >
                                        Cancel
                                    </Button>
                                    <Button 
                                        type="submit" 
                                        loading={isLoading}
                                    >
                                        Submit Request
                                    </Button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            );
        };

        // Main App Component
        const CapacityPlannerApp = () => {
            const [state, updateState] = useAppState();
            const { extendSession, logout } = useSessionManager(state, updateState);

            const handleLogin = async (email) => {
                updateState({ 
                    isLoading: true, 
                    message: null 
                });

                try {
                    const result = await apiService.login(email);
                    
                    if (result.success) {
                        const now = new Date().getTime();
                        const sessionData = {
                            userContext: result.teamMember,
                            startTime: now,
                            expiryTime: now + state.sessionDuration
                        };
                        
                        localStorage.setItem('capacityPlannerSession', JSON.stringify(sessionData));
                        
                        updateState({
                            userContext: result.teamMember,
                            sessionStartTime: now,
                            currentView: 'dashboard',
                            isLoading: false,
                            message: { type: 'success', text: `Welcome back, ${result.teamMember.First_Name__c}!` }
                        });
                    } else {
                        updateState({
                            isLoading: false,
                            message: { type: 'error', text: result.message || 'Invalid email address or user not found.' }
                        });
                    }
                } catch (error) {
                    updateState({
                        isLoading: false,
                        message: { type: 'error', text: 'Unable to connect to the server. Please try again.' }
                    });
                }
            };

            const clearMessage = () => updateState({ message: null });

            const renderCurrentView = () => {
                switch (state.currentView) {
                    case 'login':
                        return (
                            <LoginForm 
                                onLogin={handleLogin}
                                loading={state.isLoading}
                                message={state.message}
                            />
                        );
                    
                    case 'dashboard':
                        if (state.userContext?.Role__c === 'Manager') {
                            return (
                                <ManagerDashboard 
                                    userContext={state.userContext}
                                    onLoadTeamMembers={() => updateState({ currentView: 'teamMembers' })}
                                    onLoadPendingApprovals={() => updateState({ currentView: 'pendingApprovals' })}
                                    onViewTeamMemberRequests={() => updateState({ currentView: 'teamMemberRequests' })}
                                    onManageLocations={() => updateState({ currentView: 'manageLocations' })}
                                    onSprintCapacityPlanner={() => updateState({ currentView: 'sprintCapacityPlanner' })}
                                />
                            );
                        } else {
                            return (
                                <TeamMemberDashboard 
                                    userContext={state.userContext}
                                    onSubmitLeaveRequest={() => updateState({ currentView: 'submitLeaveRequest' })}
                                    onViewLeaveRequests={() => updateState({ currentView: 'viewLeaveRequests' })}
                                    onViewTeamMemberRequests={() => updateState({ currentView: 'teamMemberRequests' })}
                                />
                            );
                        }
                    
                    case 'submitLeaveRequest':
                        return (
                            <LeaveRequestForm 
                                userContext={state.userContext}
                                onSubmit={async (leaveData) => {
                                    updateState({ isLoading: true });
                                    try {
                                        const result = await apiService.submitLeaveRequest(
                                            state.userContext.Email__c,
                                            leaveData.leaveType,
                                            leaveData.leaveCategory,
                                            leaveData.startDate,
                                            leaveData.endDate,
                                            leaveData.hoursRequested,
                                            leaveData.reason,
                                            leaveData.isSingleDay
                                        );
                                        
                                        if (result.success) {
                                            updateState({
                                                currentView: 'dashboard',
                                                isLoading: false,
                                                message: { type: 'success', text: 'Leave request submitted successfully!' }
                                            });
                                        } else {
                                            updateState({
                                                isLoading: false,
                                                message: { type: 'error', text: result.message || 'Error submitting leave request.' }
                                            });
                                        }
                                    } catch (error) {
                                        updateState({
                                            isLoading: false,
                                            message: { type: 'error', text: 'Error submitting leave request. Please try again.' }
                                        });
                                    }
                                }}
                                onCancel={() => updateState({ currentView: 'dashboard' })}
                                isLoading={state.isLoading}
                            />
                        );
                    
                    case 'teamMembers':
                        return (
                            <TeamMembersView 
                                userContext={state.userContext}
                                onBack={() => updateState({ currentView: 'dashboard' })}
                            />
                        );
                    
                    case 'viewLeaveRequests':
                        return (
                            <ViewLeaveRequestsComponent 
                                userContext={state.userContext}
                                onBack={() => updateState({ currentView: 'dashboard' })}
                            />
                        );
                    
                    case 'pendingApprovals':
                        return (
                            <PendingApprovalsComponent 
                                userContext={state.userContext}
                                onBack={() => updateState({ currentView: 'dashboard' })}
                            />
                        );
                    
                    case 'teamMemberRequests':
                        return (
                            <TeamMemberRequestsComponent 
                                userContext={state.userContext}
                                onBack={() => updateState({ currentView: 'dashboard' })}
                            />
                        );
                    
                    case 'manageLocations':
                        return (
                            <LocationsView 
                                userContext={state.userContext}
                                onBack={() => updateState({ currentView: 'dashboard' })}
                            />
                        );
                    
                    case 'sprintCapacityPlanner':
                        return (
                            <SprintCapacityPlanner 
                                userContext={state.userContext}
                                onBack={() => updateState({ currentView: 'dashboard' })}
                            />
                        );
                    
                    default:
                        return (
                            <div className="app-main">
                                <div style={{ textAlign: 'center', padding: '2rem' }}>
                                    <h2>Page Not Found</h2>
                                    <Button onClick={() => updateState({ currentView: 'dashboard' })}>
                                        Return to Dashboard
                                    </Button>
                                </div>
                            </div>
                        );
                }
            };

            return (
                <div className="app-container">
                    <AppHeader 
                        userContext={state.userContext}
                        sessionStartTime={state.sessionStartTime}
                        sessionDuration={state.sessionDuration}
                        onLogout={logout}
                    />
                    
                    {state.message && (
                        <div className="app-main" style={{ paddingBottom: 0 }}>
                            <Alert 
                                type={state.message.type} 
                                message={state.message.text}
                                onClose={clearMessage}
                            />
                        </div>
                    )}
                    
                    {renderCurrentView()}
                    
                    <SessionWarningModal 
                        show={state.showSessionWarning}
                        onExtend={extendSession}
                        onLogout={logout}
                    />
                </div>
            );
        };

        // Render the app
        ReactDOM.render(<CapacityPlannerApp />, document.getElementById('react-app'));
    </script>
</apex:page>
