        // Simplified Manager Dashboard with Capacity Planning
        const ManagerDashboard = ({ userContext, onLoadTeamMembers, onLoadPendingApprovals, onViewTeamMemberRequests, onManageLocations, onSprintCapacityPlanner }) => {
            const [teamCapacityData, setTeamCapacityData] = useState([]);
            const [originalData, setOriginalData] = useState([]);
            const [hasUnsavedChanges, setHasUnsavedChanges] = useState(false);
            const [isLoading, setIsLoading] = useState(true);
            const [isSaving, setIsSaving] = useState(false);
            const [membersWithChanges, setMembersWithChanges] = useState(new Set());

            // Load team members and initialize capacity data
            useEffect(() => {
                const loadTeamCapacity = async () => {
                    if (!userContext?.Email__c) {
                        setIsLoading(false);
                        return;
                    }

                    try {
                        const result = await apiService.getTeamMembers(userContext.Email__c);
                        
                        if (result.success && result.teamMembers) {
                            // Transform team members for capacity planning
                            const capacityData = result.teamMembers.map((member, index) => {
                                const fullName = `${member.First_Name__c || ''} ${member.Last_Name__c || ''}`.trim();
                                
                                return {
                                    id: member.Id || `member_${index}`,
                                    name: fullName || 'Unknown',
                                    role: member.Role__c || 'Team Member',
                                    mon: '',
                                    tue: '',
                                    wed: '',
                                    thu: '',
                                    fri: '',
                                    sat: '',
                                    sun: '',
                                    totalCapacity: 0
                                };
                            });
                            
                            setTeamCapacityData(capacityData);
                            setOriginalData(JSON.parse(JSON.stringify(capacityData)));
                        } else {
                            setTeamCapacityData([]);
                        }
                    } catch (error) {
                        console.error('Error loading team capacity:', error);
                        setTeamCapacityData([]);
                    } finally {
                        setIsLoading(false);
                    }
                };

                loadTeamCapacity();
            }, [userContext]);

            // Calculate total capacity for a team member
            const calculateTotal = (member) => {
                const days = [member.mon, member.tue, member.wed, member.thu, member.fri, member.sat, member.sun];
                const total = days.reduce((sum, hours) => {
                    const num = parseFloat(hours) || 0;
                    return sum + num;
                }, 0);
                return total;
            };

            // Handle input change for capacity fields
            const handleCapacityChange = (memberId, field, value) => {
                setTeamCapacityData(prevData => {
                    const updatedData = prevData.map(member => {
                        if (member.id === memberId) {
                            const updatedMember = { ...member, [field]: value };
                            
                            // Auto-calculate total if it's a day field
                            if (['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'].includes(field)) {
                                updatedMember.totalCapacity = calculateTotal(updatedMember);
                            }
                            
                            return updatedMember;
                        }
                        return member;
                    });
                    
                    // Check for unsaved changes
                    const hasChanges = JSON.stringify(updatedData) !== JSON.stringify(originalData);
                    setHasUnsavedChanges(hasChanges);
                    
                    // Track which members have changes
                    const changedMembers = new Set();
                    updatedData.forEach(member => {
                        const original = originalData.find(orig => orig.id === member.id);
                        if (original && JSON.stringify(member) !== JSON.stringify(original)) {
                            changedMembers.add(member.id);
                        }
                    });
                    setMembersWithChanges(changedMembers);
                    
                    return updatedData;
                });
            };

            // Save capacity data
            const handleSaveCapacity = async () => {
                setIsSaving(true);
                try {
                    const result = await apiService.saveCapacityData(userContext.Email__c, teamCapacityData);
                    if (result.success) {
                        setOriginalData(JSON.parse(JSON.stringify(teamCapacityData)));
                        setHasUnsavedChanges(false);
                        setMembersWithChanges(new Set());
                        alert('Capacity data saved successfully!');
                    } else {
                        alert(result.message || 'Error saving capacity data. Please try again.');
                    }
                } catch (error) {
                    console.error('Error saving capacity:', error);
                    alert('Error saving capacity data. Please try again.');
                } finally {
                    setIsSaving(false);
                }
            };

            // Cancel changes
            const handleCancelChanges = () => {
                setTeamCapacityData(JSON.parse(JSON.stringify(originalData)));
                setHasUnsavedChanges(false);
                setMembersWithChanges(new Set());
            };

            if (isLoading) {
                return (
                    <div className="app-main">
                        <div style={{ textAlign: 'center', padding: '2rem' }}>
                            <LoadingSpinner />
                            <p style={{ marginTop: '1rem' }}>Loading team capacity data...</p>
                        </div>
                    </div>
                );
            }

            return (
                <div className="app-main">
                    <div style={{ marginBottom: '2rem' }}>
                        <h2 style={{ margin: '0 0 0.5rem', fontSize: '1.5rem', fontWeight: 600 }}>
                            Manager Dashboard
                        </h2>
                        <p style={{ margin: 0, color: 'var(--text-secondary)' }}>
                            Manage team capacity and approve leave requests
                        </p>
                    </div>

                    {hasUnsavedChanges && (
                        <div className="save-cancel-bar">
                            <span>You have unsaved changes</span>
                            <div style={{ display: 'flex', gap: '1rem' }}>
                                <Button 
                                    variant="secondary" 
                                    onClick={handleCancelChanges}
                                    disabled={isSaving}
                                >
                                    Cancel
                                </Button>
                                <Button 
                                    onClick={handleSaveCapacity}
                                    loading={isSaving}
                                >
                                    Save Changes
                                </Button>
                            </div>
                        </div>
                    )}

                    {/* Featured Sprint Capacity Planner Card */}
                    <div className="card slide-up" style={{ marginBottom: '2rem', background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: 'white' }}>
                        <div className="card-body" style={{ padding: '1.5rem' }}>
                            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '1rem' }}>
                                <div style={{ display: 'flex', alignItems: 'center', gap: '1rem' }}>
                                    <div style={{
                                        width: '4rem',
                                        height: '4rem',
                                        borderRadius: 'var(--radius-md)',
                                        background: 'rgba(255, 255, 255, 0.2)',
                                        display: 'flex',
                                        alignItems: 'center',
                                        justifyContent: 'center',
                                        fontSize: '2rem',
                                        boxShadow: '0 4px 15px rgba(0,0,0,0.2)'
                                    }}>
                                        📊
                                    </div>
                                    <div>
                                        <h3 style={{ margin: '0 0 0.25rem', fontSize: '1.25rem', fontWeight: 600 }}>
                                            Sprint Capacity Planner
                                        </h3>
                                        <p style={{ margin: 0, opacity: 0.9, fontSize: '0.9rem' }}>
                                            View team capacity by sprint with leaves and holidays auto-calculated
                                        </p>
                                    </div>
                                </div>
                                <Button 
                                    onClick={onSprintCapacityPlanner}
                                    style={{ 
                                        background: 'white', 
                                        color: '#667eea',
                                        fontWeight: 600,
                                        padding: '0.75rem 2rem'
                                    }}
                                >
                                    Open Sprint Planner →
                                </Button>
                            </div>
                        </div>
                    </div>

                    <div className="grid-2x2" style={{ marginBottom: '2rem' }}>
                        <DashboardCard
                            icon="👥"
                            title="Team Members"
                            description="View and manage your team members, their roles, and capacity allocation."
                            buttonText="View Team Members"
                            onClick={onLoadTeamMembers}
                        />
                        <DashboardCard
                            icon="✅"
                            title="Pending Approvals"
                            description="Review and approve or reject leave requests from your team members."
                            buttonText="Review Requests"
                            onClick={onLoadPendingApprovals}
                            variant="success"
                        />
                        <DashboardCard
                            icon="📋"
                            title="Team Member Requests"
                            description="View all leave requests from team members under your management."
                            buttonText="View Team Requests"
                            onClick={onViewTeamMemberRequests}
                        />
                        <DashboardCard
                            icon="📍"
                            title="Manage Locations"
                            description="Add, edit, and manage office locations with time zones and working hours."
                            buttonText="Manage Locations"
                            onClick={onManageLocations}
                            variant="success"
                        />
                    </div>

                </div>
            );
        };

        const TeamMemberDashboard = ({ userContext, onSubmitLeaveRequest, onViewLeaveRequests, onViewTeamMemberRequests }) => (
            <div className="app-main">
                <div style={{ marginBottom: '2rem' }}>
                    <h2 style={{ margin: '0 0 0.5rem', fontSize: '1.5rem', fontWeight: 600 }}>
                        Team Member Dashboard
                    </h2>
                    <p style={{ margin: 0, color: 'var(--text-secondary)' }}>
                        Submit leave requests and manage your schedule
                    </p>
                </div>

                <div className="grid grid-3">
                    <DashboardCard
                        icon="📝"
