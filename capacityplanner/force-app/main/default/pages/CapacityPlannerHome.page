                            <div className="grid grid-2" style={{ gap: '1rem' }}>
                                <Button variant="secondary" onClick={onClose} disabled={isProcessing}>
                                    Cancel
                                </Button>
                                <Button onClick={handleSave} loading={isProcessing}>
                                    Save Changes
                                </Button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        };

        // Cancel Leave Request Modal Component
        const CancelLeaveRequestModal = ({ show, request, onClose, onConfirm, isProcessing }) => {
            const [cancellationReason, setCancellationReason] = useState('');

            useEffect(() => {
                if (show) {
                    setCancellationReason('');
                }
            }, [show]);

            if (!show || !request) return null;

            const formatDate = (dateStr) => {
                if (!dateStr) return '-';
                const date = new Date(dateStr);
                return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            };

            const handleConfirm = () => {
                if (!cancellationReason.trim()) {
                    alert('Please provide a cancellation reason.');
                    return;
                }
                onConfirm(request.Id, cancellationReason);
            };

            return (
                <div className="modal-backdrop">
                    <div className="modal">
                        <div className="card-header">
                            <h2 style={{ margin: 0 }}>Cancel Leave Request</h2>
                        </div>
                        <div className="card-body" style={{ position: 'relative' }}>
                            {isProcessing && <div className="loading-overlay"><LoadingSpinner /></div>}
                            
                            <div className="alert alert-warning">
                                <span>⚠️ Are you sure you want to cancel this leave request? This action cannot be undone.</span>
                            </div>

                            <div style={{ background: '#f8f9fa', padding: '1rem', borderRadius: '0.5rem', marginBottom: '1rem' }}>
                                <p style={{ margin: '0 0 0.5rem', fontWeight: 500 }}>Request Details</p>
                                <p style={{ margin: '0.25rem 0', color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
                                    <strong>Type:</strong> {request.Leave_Type__c}
                                </p>
                                <p style={{ margin: '0.25rem 0', color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
                                    <strong>Dates:</strong> {formatDate(request.Start_Date__c)} - {formatDate(request.End_Date__c)}
                                </p>
                                <p style={{ margin: '0.25rem 0', color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
                                    <strong>Current Status:</strong> {request.Status__c}
                                </p>
                            </div>

                            <div className="form-group">
                                <label className="form-label">Cancellation Reason *</label>
                                <textarea
                                    className="form-input"
                                    rows="3"
                                    placeholder="Please provide a reason for cancelling this leave request..."
                                    value={cancellationReason}
                                    onChange={(e) => setCancellationReason(e.target.value)}
                                />
                            </div>

                            <div className="grid grid-2" style={{ gap: '1rem' }}>
                                <Button variant="secondary" onClick={onClose} disabled={isProcessing}>
                                    Keep Request
                                </Button>
                                <button 
                                    className="button action-btn-cancel" 
                                    style={{ width: '100%', minHeight: '2.5rem' }}
                                    onClick={handleConfirm}
                                    disabled={isProcessing}
                                >
                                    {isProcessing ? <LoadingSpinner size="sm" /> : 'Confirm Cancellation'}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            );
        };

        // View Leave Requests Component (for team members) - Enhanced with sorting, edit, cancel
        const ViewLeaveRequestsComponent = ({ userContext, onBack }) => {
            const [leaveRequests, setLeaveRequests] = useState([]);
            const [isLoading, setIsLoading] = useState(true);
            const [error, setError] = useState(null);
            const [successMessage, setSuccessMessage] = useState(null);
            
            // Sorting state
            const [sortColumn, setSortColumn] = useState('Start_Date__c');
            const [sortDirection, setSortDirection] = useState('desc');
            
            // Modal state
            const [editModalOpen, setEditModalOpen] = useState(false);
            const [cancelModalOpen, setCancelModalOpen] = useState(false);
            const [selectedRequest, setSelectedRequest] = useState(null);
            const [isProcessing, setIsProcessing] = useState(false);

            const loadLeaveRequests = async () => {
                try {
                    const result = await apiService.getLeaveRequests(userContext.Email__c);
                    if (result.success) {
                        setLeaveRequests(result.leaveRequests || []);
                    } else {
                        setError(result.message || 'Failed to load leave requests');
                    }
                } catch (err) {
                    setError('Error loading leave requests. Please try again.');
                } finally {
                    setIsLoading(false);
                }
            };

            useEffect(() => {
                loadLeaveRequests();
            }, [userContext]);

            const formatDate = (dateStr) => {
                if (!dateStr) return '-';
                const date = new Date(dateStr);
                return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            };

            const getStatusBadgeClass = (status) => {
                switch (status) {
                    case 'Approved': return 'badge-success';
                    case 'Rejected': return 'badge-error';
                    case 'Submitted': return 'badge-warning';
                    case 'Cancelled': return 'badge-cancelled';
                    default: return 'badge-warning';
                }
            };

            // Sorting logic
            const handleSort = (column) => {
                if (sortColumn === column) {
                    setSortDirection(sortDirection === 'asc' ? 'desc' : 'asc');
                } else {
                    setSortColumn(column);
                    setSortDirection('asc');
                }
            };

            const getSortIndicator = (column) => {
                if (sortColumn !== column) return '↕';
                return sortDirection === 'asc' ? '↑' : '↓';
            };

            const sortedRequests = useMemo(() => {
                const sorted = [...leaveRequests].sort((a, b) => {
                    let aVal = a[sortColumn];
                    let bVal = b[sortColumn];

                    // Handle null values
                    if (aVal === null || aVal === undefined) aVal = '';
                    if (bVal === null || bVal === undefined) bVal = '';

                    // Handle date sorting
                    if (sortColumn.includes('Date')) {
                        aVal = aVal ? new Date(aVal).getTime() : 0;
                        bVal = bVal ? new Date(bVal).getTime() : 0;
                    }

                    // Handle number sorting
                    if (sortColumn === 'Hours_Requested__c') {
                        aVal = parseFloat(aVal) || 0;
                        bVal = parseFloat(bVal) || 0;
                    }

                    // String comparison
                    if (typeof aVal === 'string') {
                        aVal = aVal.toLowerCase();
                        bVal = bVal.toLowerCase();
                    }

                    if (aVal < bVal) return sortDirection === 'asc' ? -1 : 1;
                    if (aVal > bVal) return sortDirection === 'asc' ? 1 : -1;
                    return 0;
                });
                return sorted;
            }, [leaveRequests, sortColumn, sortDirection]);

            // Check if actions are allowed for a request
            const canEditOrCancel = (status) => {
                return status === 'Submitted' || status === 'Approved';
            };

            // Handle Edit
            const handleEditClick = (request) => {
                setSelectedRequest(request);
                setEditModalOpen(true);
            };

            const handleEditSave = async (requestId, leaveType, leaveCategory) => {
                setIsProcessing(true);
                setError(null);
                
                try {
                    const result = await apiService.updateLeaveRequest(
                        userContext.Email__c, 
                        requestId, 
                        leaveType, 
                        leaveCategory
                    );
                    
                    if (result.success) {
                        setSuccessMessage('Leave request updated successfully!');
                        setEditModalOpen(false);
                        setSelectedRequest(null);
                        // Refresh the list
                        setIsLoading(true);
                        await loadLeaveRequests();
                    } else {
                        setError(result.message || 'Failed to update leave request');
                    }
                } catch (err) {
                    setError('Error updating leave request. Please try again.');
                } finally {
                    setIsProcessing(false);
                }
            };

            // Handle Cancel
            const handleCancelClick = (request) => {
                setSelectedRequest(request);
                setCancelModalOpen(true);
            };

            const handleCancelConfirm = async (requestId, cancellationReason) => {
                setIsProcessing(true);
                setError(null);
                
                try {
                    const result = await apiService.cancelLeaveRequest(
                        userContext.Email__c, 
                        requestId, 
                        cancellationReason
                    );
                    
                    if (result.success) {
                        setSuccessMessage(result.message || 'Leave request cancelled successfully!');
                        setCancelModalOpen(false);
                        setSelectedRequest(null);
                        // Refresh the list
                        setIsLoading(true);
                        await loadLeaveRequests();
                    } else {
                        setError(result.message || 'Failed to cancel leave request');
                    }
                } catch (err) {
                    setError('Error cancelling leave request. Please try again.');
                } finally {
                    setIsProcessing(false);
                }
            };

            if (isLoading) {
                return (
                    <div className="app-main">
                        <div style={{ textAlign: 'center', padding: '2rem' }}>
                            <LoadingSpinner />
                            <p style={{ marginTop: '1rem' }}>Loading leave requests...</p>
                        </div>
                    </div>
                );
            }

            return (
                <div className="app-main">
                    <div style={{ marginBottom: '1.5rem', display: 'flex', alignItems: 'center', gap: '1rem' }}>
                        <Button variant="secondary" onClick={onBack}>
                            ← Back
                        </Button>
                        <h2 style={{ margin: 0, fontSize: '1.5rem', fontWeight: 600 }}>
                            My Leave Requests
                        </h2>
                    </div>

                    {error && <Alert type="error" message={error} />}
                    {successMessage && <Alert type="success" message={successMessage} onClose={() => setSuccessMessage(null)} />}

                    <div className="card">
                        <div className="card-body">
                            {leaveRequests.length === 0 ? (
                                <div style={{ textAlign: 'center', padding: '2rem' }}>
                                    <p style={{ color: 'var(--text-secondary)' }}>
                                        No leave requests found. Submit your first leave request!
                                    </p>
                                </div>
                            ) : (
                                <div className="data-table-container">
                                    <table className="data-table">
                                        <thead>
                                            <tr>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Leave_Type__c')}
                                                >
                                                    Type
                                                    <span className={`sort-indicator ${sortColumn === 'Leave_Type__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Leave_Type__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Leave_Category__c')}
                                                >
                                                    Category
                                                    <span className={`sort-indicator ${sortColumn === 'Leave_Category__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Leave_Category__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Start_Date__c')}
                                                >
                                                    Start Date
                                                    <span className={`sort-indicator ${sortColumn === 'Start_Date__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Start_Date__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('End_Date__c')}
                                                >
                                                    End Date
                                                    <span className={`sort-indicator ${sortColumn === 'End_Date__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('End_Date__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Hours_Requested__c')}
                                                >
                                                    Hours
                                                    <span className={`sort-indicator ${sortColumn === 'Hours_Requested__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Hours_Requested__c')}
                                                    </span>
                                                </th>
                                                <th 
                                                    className="sortable-header" 
                                                    onClick={() => handleSort('Status__c')}
                                                >
                                                    Status
                                                    <span className={`sort-indicator ${sortColumn === 'Status__c' ? 'active' : ''}`}>
                                                        {getSortIndicator('Status__c')}
                                                    </span>
                                                </th>
                                                <th>Reason</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {sortedRequests.map((request, index) => (
                                                <tr key={request.Id || index}>
                                                    <td>{request.Leave_Type__c}</td>
                                                    <td>{request.Leave_Category__c}</td>
                                                    <td>{formatDate(request.Start_Date__c)}</td>
                                                    <td>{formatDate(request.End_Date__c)}</td>
                                                    <td>{request.Hours_Requested__c || '-'}</td>
                                                    <td>
                                                        <span className={`badge ${getStatusBadgeClass(request.Status__c)}`}>
                                                            {request.Status__c}
                                                        </span>
                                                    </td>
                                                    <td style={{ maxWidth: '150px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                        {request.Reason__c}
                                                    </td>
                                                    <td>
                                                        {canEditOrCancel(request.Status__c) ? (
                                                            <div style={{ display: 'flex', gap: '0.25rem' }}>
                                                                <button 
                                                                    className="button action-btn action-btn-edit"
                                                                    onClick={() => handleEditClick(request)}
                                                                    title="Edit"
                                                                >
                                                                    ✏️
                                                                </button>
                                                                <button 
                                                                    className="button action-btn action-btn-cancel"
                                                                    onClick={() => handleCancelClick(request)}
                                                                    title="Cancel"
                                                                >
                                                                    🗑️
                                                                </button>
                                                            </div>
                                                        ) : (
                                                            <span style={{ color: 'var(--text-secondary)', fontSize: '0.875rem' }}>—</span>
                                                        )}
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Edit Modal */}
                    <EditLeaveRequestModal 
                        show={editModalOpen}
                        request={selectedRequest}
                        onClose={() => { setEditModalOpen(false); setSelectedRequest(null); }}
                        onSave={handleEditSave}
                        isProcessing={isProcessing}
                    />

                    {/* Cancel Modal */}
                    <CancelLeaveRequestModal 
                        show={cancelModalOpen}
                        request={selectedRequest}
                        onClose={() => { setCancelModalOpen(false); setSelectedRequest(null); }}
                        onConfirm={handleCancelConfirm}
                        isProcessing={isProcessing}
                    />
                </div>
            );
        };

        // Pending Approvals Component (for managers)
        const PendingApprovalsComponent = ({ userContext, onBack, onRefresh }) => {
            const [pendingRequests, setPendingRequests] = useState([]);
            const [isLoading, setIsLoading] = useState(true);
            const [processingId, setProcessingId] = useState(null);
            const [error, setError] = useState(null);
            const [successMessage, setSuccessMessage] = useState(null);

            const loadPendingRequests = async () => {
                try {
                    const result = await apiService.getPendingApprovals(userContext.Email__c);
                    if (result.success) {
                        setPendingRequests(result.pendingRequests || []);
                    } else {
                        setError(result.message || 'Failed to load pending requests');
                    }
                } catch (err) {
                    setError('Error loading pending requests. Please try again.');
                } finally {
                    setIsLoading(false);
                }
            };

            useEffect(() => {
                loadPendingRequests();
            }, [userContext]);

            const formatDate = (dateStr) => {
                if (!dateStr) return '-';
                const date = new Date(dateStr);
                return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            };

            const handleApprove = async (requestId) => {
                const comments = prompt('Add approval comments (optional):');
                setProcessingId(requestId);
                setError(null);
                
                try {
                    const result = await apiService.approveLeaveRequest(userContext.Email__c, requestId, comments || '');
                    if (result.success) {
                        setSuccessMessage(result.message || 'Leave request approved successfully!');
                        setPendingRequests(prev => prev.filter(r => r.Id !== requestId));
                    } else {
                        setError(result.message || 'Failed to approve leave request');
                    }
                } catch (err) {
                    setError('Error approving leave request. Please try again.');
                } finally {
                    setProcessingId(null);
                }
            };

            const handleReject = async (requestId) => {
                const comments = prompt('Please provide rejection reason (required):');
                if (!comments || !comments.trim()) {
                    setError('Comments are required when rejecting a leave request.');
                    return;
                }
                
                setProcessingId(requestId);
                setError(null);
                
                try {
                    const result = await apiService.rejectLeaveRequest(userContext.Email__c, requestId, comments);
                    if (result.success) {
                        setSuccessMessage(result.message || 'Leave request rejected.');
                        setPendingRequests(prev => prev.filter(r => r.Id !== requestId));
                    } else {
                        setError(result.message || 'Failed to reject leave request');
                    }
                } catch (err) {
                    setError('Error rejecting leave request. Please try again.');
                } finally {
                    setProcessingId(null);
                }
            };

            if (isLoading) {
                return (
                    <div className="app-main">
                        <div style={{ textAlign: 'center', padding: '2rem' }}>
                            <LoadingSpinner />
                            <p style={{ marginTop: '1rem' }}>Loading pending approvals...</p>
                        </div>
                    </div>
                );
            }

            return (
                <div className="app-main">
                    <div style={{ marginBottom: '1.5rem', display: 'flex', alignItems: 'center', gap: '1rem' }}>
                        <Button variant="secondary" onClick={onBack}>
                            ← Back
                        </Button>
                        <h2 style={{ margin: 0, fontSize: '1.5rem', fontWeight: 600 }}>
                            Pending Approvals
                        </h2>
                    </div>

                    {error && <Alert type="error" message={error} />}
                    {successMessage && <Alert type="success" message={successMessage} onClose={() => setSuccessMessage(null)} />}

                    <div className="card">
                        <div className="card-body">
                            {pendingRequests.length === 0 ? (
                                <div style={{ textAlign: 'center', padding: '2rem' }}>
                                    <p style={{ color: 'var(--text-secondary)' }}>
                                        No pending leave requests to review.
                                    </p>
                                </div>
                            ) : (
                                <div className="data-table-container">
                                    <table className="data-table">
                                        <thead>
                                            <tr>
                                                <th>Employee</th>
                                                <th>Type</th>
                                                <th>Category</th>
                                                <th>Start Date</th>
                                                <th>End Date</th>
                                                <th>Hours</th>
                                                <th>Reason</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {pendingRequests.map((request, index) => (
                                                <tr key={request.Id || index}>
                                                    <td style={{ fontWeight: 500 }}>
                                                        {request.Requestor__r?.First_Name__c} {request.Requestor__r?.Last_Name__c}
                                                    </td>
                                                    <td>{request.Leave_Type__c}</td>
                                                    <td>{request.Leave_Category__c}</td>
                                                    <td>{formatDate(request.Start_Date__c)}</td>
                                                    <td>{formatDate(request.End_Date__c)}</td>
                                                    <td>{request.Hours_Requested__c || '-'}</td>
                                                    <td style={{ maxWidth: '150px', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                        {request.Reason__c}
                                                    </td>
                                                    <td>
                                                        <div style={{ display: 'flex', gap: '0.5rem' }}>
                                                            <Button 
                                                                variant="success" 
                                                                onClick={() => handleApprove(request.Id)}
                                                                disabled={processingId === request.Id}
                                                                loading={processingId === request.Id}
                                                            >
                                                                Approve
                                                            </Button>
                                                            <Button 
                                                                variant="secondary" 
                                                                onClick={() => handleReject(request.Id)}
                                                                disabled={processingId === request.Id}
                                                            >
                                                                Reject
                                                            </Button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            );
        };

        // Team Member Requests Component (Read-only view of all team leave requests)
        const TeamMemberRequestsComponent = ({ userContext, onBack }) => {
            const [teamRequests, setTeamRequests] = useState([]);
            const [isLoading, setIsLoading] = useState(true);
            const [error, setError] = useState(null);
            
            // Sorting state
            const [sortColumn, setSortColumn] = useState('Start_Date__c');
            const [sortDirection, setSortDirection] = useState('desc');

            useEffect(() => {
                const loadTeamRequests = async () => {
                    try {
                        const result = await apiService.getTeamMemberRequests(userContext.Email__c);
                        if (result.success) {
                            setTeamRequests(result.teamMemberRequests || []);
                        } else {
                            setError(result.message || 'Failed to load team member requests');
                        }
                    } catch (err) {
                        setError('Error loading team member requests. Please try again.');
