                                                            {location.Is_Active__c ? 'Active' : 'Inactive'}
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <button 
                                                            className="button action-btn action-btn-edit"
                                                            onClick={() => handleEditClick(location)}
                                                            title="Edit"
                                                        >
                                                            ✏️ Edit
                                                        </button>
                                                    </td>
                                                </tr>
                                            ))}
                                        </tbody>
                                    </table>
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Add/Edit Modal */}
                    <LocationModal 
